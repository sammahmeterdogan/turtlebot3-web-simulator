# Force LF line endings for shell scripts and Docker files
*.sh text eol=lf
*.bash text eol=lf
Dockerfile text eol=lf
*.Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf

# Java files
*.java text eol=lf

# JavaScript/TypeScript
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf

# Other text files
*.md text eol=lf
*.txt text eol=lf
*.properties text eol=lf

